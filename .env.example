# --- INVERSORIA: PLANTILLA DE CONFIGURACIÓN ---
# Copia este archivo como .env y rellena tus claves

# CRYPTO.COM EXCHANGE
CRYPTO_API_KEY=tu_clave_aqui
CRYPTO_API_SECRET=tu_secreto_aqui

# INTELIGENCIA ARTIFICIAL (Modelos de Lenguaje)
# Se recomienda tener al menos Gemini y Groq para el sistema de redundancia
GOOGLE_API_KEY=AIzaSy...
GROQ_API_KEY=gsk_...
SAMBANOVA_API_KEY=...

# ANÁLISIS DE MERCADOS GLOBALES (v6.1+)
# Consigue tu clave gratuita en: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=tu_clave_alpha_vantage

# NOTICIAS (Opcional)
COINDESK_API_KEY=...

# NOTA: Este archivo debe mantenerse privado. No lo compartas ni lo subas a repositorios públicos.
